# ==============================================================================
# POSTGRES
# ==============================================================================

# Name of the PostgreSQL database created for n8n.
POSTGRES_DB="n8n"

# PostgreSQL superuser used during database initialization.
POSTGRES_USER="postgres"

# Password for the PostgreSQL superuser. PostgreSQL reads this only when it initializes an empty data volume; changing it later does not update the password.
POSTGRES_PASSWORD="CHANGE_ME"

# Non-root PostgreSQL user used by n8n.
POSTGRES_NON_ROOT_USER="n8n"

# Password for the non-root PostgreSQL user. This is also applied only when PostgreSQL initializes an empty data volume.
POSTGRES_NON_ROOT_PASSWORD="CHANGE_ME"

# ==============================================================================
# N8N
# ==============================================================================

# n8n image version. Stored as a variable to keep the n8n and task-runner image versions matched.
N8N_VERSION="2.39.9"

# Encryption key for stored credentials. Never change it after credentials are stored, or they will become undecryptable.
N8N_ENCRYPTION_KEY="CHANGE_ME"

# Timezone used by n8n. Use a value from https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
GENERIC_TIMEZONE="America/Los_Angeles"

# System timezone inside the container. Keep this in sync with GENERIC_TIMEZONE.
TZ="America/Los_Angeles"

# Prevent expressions and Code nodes from reading the n8n container's environment.
N8N_BLOCK_ENV_ACCESS_IN_NODE="true"

# Restrict the n8n settings file to owner read/write access (mode 0600).
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS="true"

# Maximum concurrent production executions. Additional executions are queued; five is a conservative starting point for a small personal instance.
N8N_CONCURRENCY_PRODUCTION_LIMIT="5"

# Maximum simultaneous Code node tasks. Keeping this below the production execution limit reduces memory spikes; increase it only after watching usage.
N8N_RUNNERS_MAX_CONCURRENCY="2"

# Time in seconds n8n allows its components to shut down cleanly.
N8N_GRACEFUL_SHUTDOWN_TIMEOUT="30"

# Disable the public REST API when it is not needed. This does not disable workflow webhooks or the editor API. See https://docs.n8n.io/connect/n8n-api/
N8N_PUBLIC_API_DISABLED="true"

# Disable the public REST API playground when it is not needed.
N8N_PUBLIC_API_SWAGGERUI_DISABLED="true"

# Disable installation and use of all community packages.
N8N_COMMUNITY_PACKAGES_ENABLED="false"

# Prevent installation of unverified community packages when community packages are enabled.
N8N_UNVERIFIED_PACKAGES_ENABLED="false"

# Maximum task-runner execution time in seconds.
N8N_RUNNERS_TASK_TIMEOUT="60"

# Maximum decompressed output from the Compression node in bytes (256 MiB).
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES="268435456"

# Maximum entries allowed in an archive.
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES="1000"

# Shared authentication token used by n8n and its external task runners.
N8N_RUNNERS_AUTH_TOKEN="CHANGE_ME"

# Protective CPU ceiling for Code nodes on a small personal instance.
DOCKER_N8N_RUNNERS_CPU_LIMIT="2.0"

# Protective memory ceiling for concurrent Code tasks. Large files and Python libraries may need more; watch memory before increasing concurrency.
DOCKER_N8N_RUNNERS_MEMORY_LIMIT="1g"

# Protective process ceiling for the task-runner container.
DOCKER_N8N_RUNNERS_PIDS_LIMIT="128"

# ==============================================================================
# NGROK
# ==============================================================================

# Authentication token used to connect the local ngrok agent to your account.
NGROK_AUTHTOKEN="CHANGE_ME"

# Public ngrok hostname that forwards traffic to n8n. Omit https:// and the trailing slash (for example, example.ngrok-free.app).
NGROK_PUBLIC_DOMAIN="CHANGE_ME"
